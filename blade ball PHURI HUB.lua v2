-- ================= PART 3: FUNCTIONS =================
local function GetBall()
    if not HRP or not HRP.Parent then return nil end
    for _, v in pairs(workspace:GetChildren()) do
        if v:IsA("BasePart") and v.Name:find("Ball") and v:IsDescendantOf(workspace) then
            if (v.Position - HRP.Position).Magnitude <= 200 then return v end
        end
    end
end

local function FireParry()
    VIM:SendKeyEvent(true, Enum.KeyCode.F, false, game)
    task.wait(0.05)
    VIM:SendKeyEvent(false, Enum.KeyCode.F, false, game)
end

-- ================= PART 4: LOOPS =================
RunService.RenderStepped:Connect(function()
    if not F.Parry or tick() - LastParry < S.Cooldown then return end
    local ball = GetBall()
    if not ball or (ball == LastBall and tick() - LastParry < 1) then return end
    local tgt = ball:GetAttribute("target")
    if tgt and tgt ~= LP.Name then return end
    
    if not F.Precise then
        if (ball.Position - HRP.Position).Magnitude < S.Hitbox then
            LastParry = tick(); LastBall = ball; task.spawn(FireParry)
        end
        return
    end
    
    local ping = LP:GetNetworkPing()
    local rp = ball.Position - HRP.Position
    local rv = ball.AssemblyLinearVelocity - HRP.AssemblyLinearVelocity
    local ttc = -rp:Dot(rv) / math.max(rv:Dot(rv), 0.001)
    if ttc < 0 then return end
    local cpos = rp + (rv * ttc)
    if cpos.Magnitude > S.Hitbox then return end
    local off = math.sqrt(math.max(S.Hitbox^2 - cpos.Magnitude^2, 0)) / math.max(rv.Magnitude, 0.001)
    local tth = ttc - off
    if tth <= (ping + S.PingBuff) and tth > -0.1 then
        LastParry = tick(); LastBall = ball; task.spawn(FireParry)
    end
end)

RunService.Heartbeat:Connect(function(dt)
    local ball = GetBall()
    if F.Orbit and ball then
        if (ball.Position - HRP.Position).Magnitude < 150 then
            orbitAngle = orbitAngle + (math.pi * 2) * (S.Speed * dt)
            local ox = math.cos(orbitAngle) * S.Radius
            local oz = math.sin(orbitAngle) * S.Radius
            ball.CFrame = HRP.CFrame * CFrame.new(ox, 3, oz)
        end
    end
    
    if F.BallESP then
        if ball and not ball:FindFirstChild("PH_ESP") then
            local h = Instance.new("Highlight", ball); h.Name = "PH_ESP"; h.FillColor = Color3.fromRGB(255,0,100); h.OutlineColor = Color3.fromRGB(255,255,255); h.FillTransparency = 0.3
        end
    end
    if F.PlayerESP then
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LP and p.Character and not p.Character:FindFirstChild("PH_ESP_P") then
                local h = Instance.new("Highlight", p.Character); h.Name = "PH_ESP_P"; h.FillColor = Color3.fromRGB(255,100,0); h.OutlineColor = Color3.fromRGB(255,255,255); h.FillTransparency = 0.5
            end
        end
    end
end)

